{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-iab-youtube",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {"JEV_MODEL": "jev-latest"},
  "observability": {"enabled": false}
}
