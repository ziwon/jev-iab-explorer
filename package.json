{
  "name": "jev-iab-youtube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Metadata-first YouTube IAB classification with transcript fallback, on Workers or localhost",
  "engines": {"node": ">=22.0.0"},
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars scripts/server.mjs",
    "demo": "node scripts/server.mjs --demo-only",
    "init:local": "node scripts/init-local.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover -s tests -p test_*.py",
    "cf:dev": "npx wrangler@4 dev --local",
    "cf:check": "npx wrangler@4 deploy --dry-run",
    "deploy": "npx wrangler@4 deploy"
  }
}
